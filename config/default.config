import nextflow.util.SysHelper
import nextflow.Nextflow

// Default inputs/parameters of the pipeline
params {
    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB

    save_intermediate_files = false

    dataset_id = ''
    blcds_registered_dataset = false

    ucla_cds = false
    docker_container_registry_uclahscds = "ghcr.io/uclahs-cds"
    docker_container_registry_theboutroslab = "ghcr.io/theboutroslab"

    // Docker images
    bcftools_version   = '1.22_score-1.22-20250819'
    bedtools_version   = '2.31.1'
    gatk_version       = '4.6.2.0'
    pipeval_version    = '5.2.0'
    samtools_version   = '1.23'
    stablelift_version = '1.0.0'

    docker_image_bcftools = "${-> params.docker_container_registry_theboutroslab}/bcftools-score:1.20_score-1.20-20240505"
    docker_image_bedtools = "${-> params.docker_container_registry_theboutroslab}/bedtools:${params.bedtools_version}"
    docker_image_gatk = "broadinstitute/gatk:${params.gatk_version}"
    docker_image_pipeval = "${-> params.docker_container_registry_uclahscds}/pipeval:${params.pipeval_version}"
    docker_image_samtools = "${-> params.docker_container_registry_theboutroslab}/samtools:${params.samtools_version}"
    docker_image_stablelift = "${-> params.docker_container_registry_uclahscds}/stablelift:${params.stablelift_version}"
}

// Process specific scope
process {
    // Process results are stored to local cache.
    // If pipeline is launched with the 'resume' option, existing cache results
    // will be used when available rather than re-executing processes
    cache = true

    // Forward process 'stdout' to shell terminal and, consequently, the log file
    echo = true
    executor = 'local'

    // Total amount of resources available to the pipeline
    cpus = params.max_cpus
    memory = params.max_memory
}

profiles {
    standard {
        apptainer {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
        params.platform_set = "--platform linux/amd64"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        apptainer {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
        params.platform_set = "--platform linux/amd64"
    }

    apptainer {
        docker {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
        params.platform_set = ""
    }
}
